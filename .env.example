# Скопируйте в .env и заполните. .env в репозиторий не коммитится.
# Ключи в config.yaml не пишутся — там только ссылки ${VAR}.

# ── LLM: OpenAI-совместимый endpoint ────────────────────────────────────────
# Разработка: SiliconFlow. Финал: инференс VK — меняются только эти три строки.
# Внимание: у SiliconFlow два независимых сервиса — .com и .cn. Аккаунты и
# ключи у них разные, ключ одного на другом отвечает "Token is invalid".
LLM_BASE_URL=https://api.siliconflow.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.6-27B

# ── VLM: контекстный аудит по картинке слайда ───────────────────────────────
# Может быть тот же endpoint и тот же ключ, что у LLM.
VLM_BASE_URL=https://api.siliconflow.com/v1
VLM_API_KEY=
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# ── Другой провайдер для отдельного агента (необязательно) ──────────────────
# Агент берёт их, если в его файле agents/*.yaml заданы
#   base_url: ${DEEPINFRA_BASE_URL}
#   api_key: ${DEEPINFRA_API_KEY}
# DeepInfra: Qwen/Qwen3.6-27B и Qwen/Qwen2.5-VL-32B-Instruct — те же имена.
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=
# Fireworks: имена вида accounts/fireworks/models/qwen2p5-vl-32b-instruct.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=

# ── text-to-image: задача со звёздочкой, по умолчанию выключено ─────────────
T2I_BASE_URL=
T2I_API_KEY=
T2I_MODEL=

# ── Веб-интерфейс ───────────────────────────────────────────────────────────
# Пароль на вход. Обязателен для публичного адреса: каждый прогон тратит
# ключ модели. Пусто — вход открыт (локальный запуск).
DECKWRIGHT_PASSWORD=
